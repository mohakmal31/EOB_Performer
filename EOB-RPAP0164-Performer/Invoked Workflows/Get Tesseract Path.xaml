       End Using&#xA;    Catch ex As Exception&#xA;        ' where.exe failed or not found, continue to next check&#xA;    End Try&#xA;End If&#xA;&#xA;' --- Step 3: Scan common root folders as a last resort ---&#xA;If Not out_Found Then&#xA;    Dim roots As String() = {&#xA;        Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),&#xA;        Environment.GetFolderPath(Environment.SpecialFolder.ProgramFiles),&#xA;        Environment.GetFolderPath(Environment.SpecialFolder.ProgramFilesX86)&#xA;    }&#xA;&#xA;    For Each root In roots&#xA;        If out_Found Then Exit For&#xA;        Try&#xA;            Dim matches As String() = Directory.GetFiles(root, &quot;tesseract.exe&quot;, SearchOption.AllDirectories)&#xA;            If matches.Length &gt; 0 Then&#xA;                out_TesseractPath = matches(0)&#xA;                out_Found = True&#xA;            End If&#xA;        Catch ex As UnauthorizedAccessException&#xA;            ' Skip folders we can't read&#xA;        Catch ex As Exception&#xA;            ' Skip any other scan errors for this root and keep going&#xA;        End Try&#xA;    Next&#xA;End If" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="502,197.33333333333334" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
